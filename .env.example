# Nova environment configuration
# Copy this file to `.env` and fill in the values you need.
# Never commit `.env` — it is git-ignored.

# ── Core runtime ─────────────────────────────────────────────────────────────
NOVA_LOG_LEVEL=INFO
NOVA_HOST=127.0.0.1
NOVA_PORT=8008
NOVA_CONTEXT_TOKENS=8192
NOVA_MEMORY_DIR=memory_data

# ── Cloud LLM (optional, OFF by default) ────────────────────────────────────
# Routes ONLY the roles you choose to a remote model. Everything personal —
# chat, memory, decisions — always stays on the local GPU. Outbound prompts pass
# a context firewall that drops grounding/memory blocks and redacts names; if
# anything personal survives, the call is refused and falls back to local.
# Any failure (no key, HTTP error, timeout) silently falls back to local too.
NOVA_CLOUD_ENABLED=0
# 'openai' works with OpenAI, OpenRouter, Together, Groq, vLLM, LM Studio and
# most gateways (set NOVA_CLOUD_BASE_URL). 'anthropic' uses the Messages API.
NOVA_CLOUD_PROVIDER=openai
NOVA_CLOUD_API_KEY=
NOVA_CLOUD_MODEL=
# Leave empty for the provider default, or point at any compatible endpoint,
# e.g. https://openrouter.ai/api/v1  or  http://localhost:1234/v1
NOVA_CLOUD_BASE_URL=
NOVA_CLOUD_TIMEOUT_S=120
NOVA_CLOUD_CONCURRENCY=4
# When cloud is enabled, coder+planner route to it automatically. Override any
# role explicitly here (this always wins), e.g. NOVA_MODEL_ROLES=critic=cloud
# or force everything local with NOVA_MODEL_ROLES=coder=primary,planner=primary
NOVA_MODEL_ROLES=

# Model selection (leave empty to auto-pick the newest model/*.gguf)
NOVA_MODEL_PATH=
NOVA_MODEL_DIR=
NOVA_MMPROJ_PATH=
NOVA_CHAT_FORMAT=
NOVA_MAIN_GPU=0

# ── Voice ────────────────────────────────────────────────────────────────────
NOVA_VOICE_DIR=voices
NOVA_DEFAULT_VOICE=nova.wav
NOVA_TTS_DEVICE=cuda
# Load + warm XTTS at startup so Nova speaks without first-use delay
NOVA_TTS_PREWARM=1
# Required for the one-time XTTS v2 model download (~1.9 GB).
# Setting 1 accepts the Coqui CPML license: https://coqui.ai/cpml
COQUI_TOS_AGREED=1
# STT: faster-whisper model size (tiny|base|small|medium)
NOVA_STT_MODEL_SIZE=base

# ── Memory embeddings (semantic recall) ─────────────────────────────────────
NOVA_EMBED_MODEL=BAAI/bge-small-en-v1.5
NOVA_EMBED_DEVICE=auto
NOVA_STT_MODEL=openai/whisper-base
# Set if ffmpeg is not on PATH:
NOVA_FFMPEG_PATH=
# Record provenance on every stored fact (source, evidence, verification status,
# last-confirmed date) so Nova never presents an assumption as a settled fact.
NOVA_MEMORY_PROVENANCE=1
# Semantic world model (#11): general knowledge (subject-predicate-object + source)
# so Nova can answer from memory instead of re-searching the web.
NOVA_WORLD_MODEL=1
# Persistent internal thoughts (#6): ongoing private notes across sessions,
# surfaced only when you ask. Not injected into every reply.
NOVA_INTERNAL_THOUGHTS=1
# Personal digital twin (#4): model your working patterns (work hours, focus
# window, procrastination likelihood) from recorded signals. Predicts, never
# impersonates. Executive intelligence (#1): proactive, confidence-gated
# recommendations synthesized from goals/reminders/habits/twin/weather.
NOVA_DIGITAL_TWIN=1
NOVA_EXECUTIVE=1
# Persistent agent society (#5): a council of durable specialists (Chief Engineer,
# Research Scientist, Psychologist, coaches, ...) the Executive convenes for
# questions that benefit from multiple expert angles. Turn-based on one GPU.
NOVA_AGENT_SOCIETY=1

# ── Behavior / autonomy ──────────────────────────────────────────────────────
NOVA_AUTONOMY=1
# Autonomous research (#9): periodically search→summarize→cite tracked topics
# into the world model. OFF by default — it makes network calls. Turn on to let
# Nova keep your research interests fresh on her own.
NOVA_RESEARCH=0
NOVA_RESEARCH_INTERVAL_S=3600
# Internal operational state (#12): derive reasoning/operational metrics
# (confidence, uncertainty, workload, focus, energy, curiosity, learning rate)
# from real telemetry and let them advise how Nova replies. Not simulated moods.
NOVA_INTERNAL_STATE=1
# Self-benchmarking (#14): trend the daily self-eval history and flag regressions.
NOVA_SELF_BENCHMARK=1
NOVA_ALLOW_SHELL=1
NOVA_ALLOW_NETWORK_TOOLS=1
NOVA_RECENT_CHAT_TURNS=20
NOVA_SUMMARY_EVERY_N=8

# ── Developer mode (self-inspection; DISABLED by default) ───────────────────
# Set to 1 to let Nova read her own code and propose diffs (writes always
# require explicit user approval; see core/dev_mode.py).
NOVA_DEV_MODE=0

# ── Computer control permissions (Phase 8) ──────────────────────────────────
# Permission policy for any actuator: locked (read-only) | guarded (default —
# standard/admin actions need your confirmation, critical denied) | trusted.
NOVA_PERMISSION_MODE=guarded
# Allow computer-control actions to actually execute. OFF by default: even a
# permitted action is a dry run (no input synthesized) unless this is 1 AND a
# platform adapter is installed. There is no armed autonomous actuator by default.
NOVA_COMPUTER_CONTROL=0

# ── Security ─────────────────────────────────────────────────────────────────
# API auth (recommended): when set, EVERY endpoint (except /health) requires
# Authorization: Bearer <token>. The UI picks it up automatically (Electron env
# or localStorage "nova_api_token"). Leave empty only for localhost-only use.
# Generate one:  python -c "import secrets; print(secrets.token_urlsafe(32))"
NOVA_API_TOKEN=
# Optional token required for maintenance endpoints like /memory/purge
NOVA_ADMIN_TOKEN=
# Comma-separated CORS origins (default: Vite dev + Electron)
NOVA_ALLOWED_ORIGINS=

# ── API keys (features degrade gracefully to "not configured" if empty) ─────
OPENWEATHER_API_KEY=
GOOGLE_MAPS_API_KEY=
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=

# Calendar (read-only) + Gmail (read + draft-only, never send). See
# tools/README_google_oauth.md for setup; requires a one-time consent run of
# tools/google_oauth_setup.py after these are set.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
