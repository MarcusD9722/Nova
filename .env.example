# Nova environment configuration
# Copy this file to `.env` and fill in the values you need.
# Never commit `.env` — it is git-ignored.

# ── Core runtime ─────────────────────────────────────────────────────────────
NOVA_LOG_LEVEL=INFO
NOVA_HOST=127.0.0.1
NOVA_PORT=8008
NOVA_CONTEXT_TOKENS=8192
NOVA_MEMORY_DIR=memory_data

# Model selection (leave empty to auto-pick the newest model/*.gguf)
NOVA_MODEL_PATH=
NOVA_MODEL_DIR=
NOVA_MMPROJ_PATH=
NOVA_CHAT_FORMAT=
NOVA_MAIN_GPU=0

# ── Voice ────────────────────────────────────────────────────────────────────
NOVA_VOICE_DIR=voices
NOVA_DEFAULT_VOICE=nova.wav
NOVA_TTS_DEVICE=cuda
# Load + warm XTTS at startup so Nova speaks without first-use delay
NOVA_TTS_PREWARM=1
# Required for the one-time XTTS v2 model download (~1.9 GB).
# Setting 1 accepts the Coqui CPML license: https://coqui.ai/cpml
COQUI_TOS_AGREED=1
# STT: faster-whisper model size (tiny|base|small|medium)
NOVA_STT_MODEL_SIZE=base

# ── Memory embeddings (semantic recall) ─────────────────────────────────────
NOVA_EMBED_MODEL=BAAI/bge-small-en-v1.5
NOVA_EMBED_DEVICE=auto
NOVA_STT_MODEL=openai/whisper-base
# Set if ffmpeg is not on PATH:
NOVA_FFMPEG_PATH=

# ── Behavior / autonomy ──────────────────────────────────────────────────────
NOVA_AUTONOMY=1
NOVA_AUTONOMY_MAX_STEPS=12
NOVA_ALLOW_SHELL=1
NOVA_ALLOW_NETWORK_TOOLS=1
NOVA_RECENT_CHAT_TURNS=20
NOVA_SUMMARY_EVERY_N=8

# ── Developer mode (self-inspection; DISABLED by default) ───────────────────
# Set to 1 to let Nova read her own code and propose diffs (writes always
# require explicit user approval; see core/dev_mode.py).
NOVA_DEV_MODE=0

# ── Security ─────────────────────────────────────────────────────────────────
# Optional token required for maintenance endpoints like /memory/purge
NOVA_ADMIN_TOKEN=
# Comma-separated CORS origins (default: Vite dev + Electron)
NOVA_ALLOWED_ORIGINS=

# ── API keys (features degrade gracefully to "not configured" if empty) ─────
OPENWEATHER_API_KEY=
GOOGLE_MAPS_API_KEY=
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=

# Calendar (read-only) + Gmail (read + draft-only, never send). See
# tools/README_google_oauth.md for setup; requires a one-time consent run of
# tools/google_oauth_setup.py after these are set.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
