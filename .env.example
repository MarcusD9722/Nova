# ============================================================================
# Nova configuration — EVERY setting, with what it does above each line.
#
# GENERATED FILE. Regenerate after adding a setting:
#     .\venv\Scripts\python.exe tools\gen_env_example.py
#
# To use it:  Copy-Item .env.example .env   then fill in the keys you want.
#
# Lines with a default are COMMENTED OUT and show that default — copying this
# file is therefore safe: you inherit defaults by omission rather than pinning
# today's values. Uncomment a line only to override it.
#
# NEVER commit your real .env — it is git-ignored on purpose. Secrets belong
# only in .env and credentials/, both of which Nova's self-editing refuses to
# read or modify.
# ============================================================================

# ─────────────────────────────────────────────────────────────────────────
# Third-party API keys (all optional — features report 'not configured')
# ─────────────────────────────────────────────────────────────────────────

# Weather lookups (weather.current). Free tier at openweathermap.org.
OPENWEATHER_API_KEY=

# Maps, geocoding, places and directions (maps.* tools + the map panel).
GOOGLE_MAPS_API_KEY=

# Discord bot token for discord.send / discord.read.
DISCORD_BOT_TOKEN=

# The Discord channel id Nova posts to and reads from.
DISCORD_CHANNEL_ID=

# Google OAuth client id — calendar (read-only) + Gmail (read + DRAFT only).
GOOGLE_OAUTH_CLIENT_ID=

# Google OAuth client secret. See tools/README_google_oauth.md.
GOOGLE_OAUTH_CLIENT_SECRET=

# Set 1 to accept the Coqui CPML licence for the one-time XTTS download (~1.9
# GB).
COQUI_TOS_AGREED=1


# ─────────────────────────────────────────────────────────────────────────
# Core runtime
# ─────────────────────────────────────────────────────────────────────────

# Bind address for the backend.
# type: str · default: 127.0.0.1
# NOVA_HOST=127.0.0.1

# Backend port.
# type: int · default: 8008
# NOVA_PORT=8008

# Reported version string.
# type: str · default: 0.1.0
# NOVA_VERSION=0.1.0

# Override repo root autodetection.
# type: path · default: (empty)
# NOVA_REPO_ROOT=

# Runtime memory storage directory.
# type: path · default: memory_data
# NOVA_MEMORY_DIR=memory_data

# Directory for Nova-built projects.
# type: path · default: projects
# NOVA_PROJECTS_DIR=projects

# ─────────────────────────────────────────────────────────────────────────
# Logging
# ─────────────────────────────────────────────────────────────────────────

# Application log level.
# type: str · default: INFO
# NOVA_LOG_LEVEL=INFO

# Log format override (console|json; empty = auto).
# type: str · default: (empty)
# NOVA_LOG_FORMAT=

# Level for chatty third-party loggers.
# type: str · default: WARNING
# NOVA_NOISY_LOG_LEVEL=WARNING

# llama.cpp native log level.
# type: str · default: ERROR
# NOVA_LLAMA_LOG_LEVEL=ERROR

# Log per-call LLM performance stats.
# type: bool · default: 0
# NOVA_LLM_PERF_LOG=0

# ─────────────────────────────────────────────────────────────────────────
# Model / LLM
# ─────────────────────────────────────────────────────────────────────────

# Explicit GGUF path (empty = newest in model dir).
# type: path · default: (empty)
# NOVA_MODEL_PATH=

# Model directory override (default: model/).
# type: path · default: (empty)
# NOVA_MODEL_DIR=

# Explicit mmproj GGUF for vision (empty = auto-detect).
# type: path · default: (empty)
# NOVA_MMPROJ_PATH=

# llama-cpp chat format override.
# type: str · default: (empty)
# NOVA_CHAT_FORMAT=

# Role→model remap once a second model handle exists, e.g. 'coder=secondary'.
# Empty = every role on the primary model.
# type: str · default: (empty)
# NOVA_MODEL_ROLES=

# ─────────────────────────────────────────────────────────────────────────
# Cloud LLM (U2): opt-in, per-role, firewalled. Off by default.
# ─────────────────────────────────────────────────────────────────────────

# Route selected roles (default coder+planner) to a remote model. OFF by
# default; chat/memory/decisions always stay local.
# type: bool · default: 0
# NOVA_CLOUD_ENABLED=0

# Cloud API shape: 'openai' (OpenAI, OpenRouter, Together, Groq, vLLM, LM
# Studio, …) or 'anthropic'.
# type: str · default: openai
# NOVA_CLOUD_PROVIDER=openai

# API key for the cloud provider.
# (secret — keep this only in .env, never in .env.example)
NOVA_CLOUD_API_KEY=

# Remote model id, e.g. 'gpt-4o' or 'claude-sonnet-4-5'.
# type: str · default: (empty)
# NOVA_CLOUD_MODEL=

# Override the provider base URL (any OpenAI-compatible endpoint). Empty =
# provider default.
# type: str · default: (empty)
# NOVA_CLOUD_BASE_URL=

# Cloud request timeout in seconds.
# type: float · default: 120
# NOVA_CLOUD_TIMEOUT_S=120

# How many cloud calls may run at once (remote calls don't contend for the
# GPU).
# type: int · default: 4
# NOVA_CLOUD_CONCURRENCY=4

# Stop using the cloud model after this many tokens in a day (0 = no cap).
# Falls back to local, never fails a turn (U6).
# type: int · default: 0
# NOVA_CLOUD_DAILY_TOKEN_CAP=0

# USD per 1M input tokens, for the spend ESTIMATE on /status. 0 = don't
# estimate.
# type: float · default: 0
# NOVA_CLOUD_COST_PER_MTOK_IN=0

# USD per 1M output tokens, for the spend ESTIMATE on /status.
# type: float · default: 0
# NOVA_CLOUD_COST_PER_MTOK_OUT=0

# anthropic-version header when NOVA_CLOUD_PROVIDER=anthropic.
# type: str · default: 2023-06-01
# NOVA_CLOUD_ANTHROPIC_VERSION=2023-06-01

# Model context window.
# type: int · default: 8192
# NOVA_CONTEXT_TOKENS=8192

# Default reply token budget.
# type: int · default: 1536
# NOVA_MAX_TOKENS=1536

# CUDA device index for the LLM.
# type: int · default: 0
# NOVA_MAIN_GPU=0

# Globally allow reasoning blocks in replies.
# type: bool · default: (empty)
# NOVA_LLM_ALLOW_THINKING=

# FAST reasoning contract: prefill an already-closed reasoning block so
# ordinary replies skip hidden reasoning entirely. Measured (V3 P2.5): first
# visible token 8169ms -> 36ms median, empty replies 5/18 -> 0/18. Set 0 to
# fall back to the old '/no_think' switch, which barely worked on this model.
# type: bool · default: 1
# NOVA_LLM_FAST_PREFILL=1

# Force-enable vision even if detection is unsure.
# type: bool · default: (empty)
# NOVA_VISION_FORCE=

# ─────────────────────────────────────────────────────────────────────────
# Voice
# ─────────────────────────────────────────────────────────────────────────

# Reference-voice wav directory.
# type: path · default: voices
# NOVA_VOICE_DIR=voices

# Default reference voice filename.
# type: str · default: (empty)
# NOVA_DEFAULT_VOICE=

# XTTS device (auto|cuda|cpu). auto = CUDA when available, which is safe
# because XTTS now runs in its OWN process with its own CUDA context
# (services/tts_worker.py); the illegal-memory-access crash came from sharing
# a process with llama.cpp, not from sharing the card. cuda = hard
# requirement, errors if unavailable. cpu = deliberate, supported, never
# errors. Policy lives in services/xtts_engine.py::resolve_device.
# type: str · default: auto
# NOVA_TTS_DEVICE=auto

# With NOVA_TTS_DEVICE=auto and no CUDA: 0 = report the voice degraded and say
# why; 1 = fall back to the (much slower) CPU voice. Off by default so Nova
# never silently downgrades itself.
# type: bool · default: 0
# NOVA_TTS_ALLOW_CPU_FALLBACK=0

# Run XTTS in an isolated child process. 0 forces the legacy in-process
# loader, which CANNOT use CUDA safely beside llama.cpp — debugging only.
# type: bool · default: 1
# NOVA_TTS_ISOLATED=1

# Seconds before a single synthesis is treated as wedged and the worker is
# replaced.
# type: float · default: 60
# NOVA_TTS_SYNTH_TIMEOUT=60

# Seconds allowed for the XTTS worker to load (first run may download ~1.9
# GB).
# type: float · default: 300
# NOVA_TTS_START_TIMEOUT=300

# Max sentences queued for synthesis before new ones are rejected instead of
# queued.
# type: int · default: 32
# NOVA_TTS_MAX_BACKLOG=32

# How many times a crashed XTTS worker is restarted before Nova stops trying
# and reports degraded.
# type: int · default: 3
# NOVA_TTS_MAX_RESTARTS=3

# Largest single piece of cold evidence Nova will store (bytes). A tool
# producing more than this is refused rather than silently filling the memory
# directory.
# type: int · default: 8388608
# NOVA_COLD_MAX_BYTES=8388608

# Local speaker identification for voice commands (V3 P5). Identifies WHO is
# speaking so memory is attributed to the right person; it is NOT
# authentication and never bypasses a permission confirmation. Set 0 to load
# no model, compute no embeddings, and leave /stt exactly as it was.
# type: bool · default: 1
# NOVA_SPEAKER_ID=1

# Where the speaker embedding model runs: cpu (default) or cuda. CPU measured
# 41-58ms per utterance and is provably unaffected by GPU load; CUDA is ~5.7ms
# but adds a third consumer to a GPU that P1 measured as already contended.
# Change only with re-measurement.
# type: str · default: cpu
# NOVA_SPEAKER_DEVICE=cpu

# Cosine similarity a voice must reach to be called a known speaker.
# PROVISIONAL until tests/live_speaker_id_harness.md is run with real people;
# a guest wrongly accepted as Marcus is far worse than an honest 'unknown'.
# type: float · default: 0.55
# NOVA_SPEAKER_THRESHOLD=0.55

# How far the best match must beat the runner-up. Two enrolled speakers
# scoring 0.81 and 0.79 are not distinguishable, so Nova reports 'ambiguous'
# rather than picking. PROVISIONAL.
# type: float · default: 0.10
# NOVA_SPEAKER_MARGIN=0.10

# Where the ECAPA speaker model is cached (empty = model/speaker/ecapa under
# the repo).
# type: path · default: (empty)
# NOVA_SPEAKER_MODEL_DIR=

# Durable memory of what HAPPENED (episodes, past result sets, decisions),
# persisted to the same SQLite database as facts. Writes go through a
# background worker; retrieval is gated and only runs for turns that reference
# the past. Set 0 to keep hot artifacts and facts but store no history.
# type: bool · default: 1
# NOVA_EPISODIC_MEMORY=1

# How long a tool result set stays 'on screen' and is injected into the
# prompt. Older sets remain addressable by reference but stop consuming
# context every turn.
# type: float · default: 900
# NOVA_ARTIFACT_WINDOW_S=900

# Skip the broad semantic memory search when working context already answers
# the turn (memory/recall_gate.py). Fails open: anything it does not
# positively recognise still searches. Set 0 to always search, as before.
# type: bool · default: 1
# NOVA_RECALL_GATE=1

# MCP servers as a JSON object of server-id -> {command, args, env, cwd,
# enabled}. Each server's tools become namespaced Nova capabilities
# (mcp:<server>:<tool>) that go through ToolSelector, permissions, the context
# firewall and artifacts like any other tool. Empty = MCP off.
# type: str · default: (empty)
# NOVA_MCP_SERVERS=

# Largest JSON-RPC frame accepted from an MCP server, in bytes.
# type: int · default: 4194304
# NOVA_MCP_MAX_FRAME=4194304

# Cap on MCP tool result text entering a prompt. A huge result is a
# context-budget attack even when honest.
# type: int · default: 8000
# NOVA_MCP_MAX_RESULT_CHARS=8000

# Seconds allowed for an MCP server handshake.
# type: float · default: 20
# NOVA_MCP_STARTUP_TIMEOUT=20

# Seconds allowed for a single MCP tool call.
# type: float · default: 30
# NOVA_MCP_CALL_TIMEOUT=30

# Preselect a handful of plausible tools before the agent loop instead of
# showing the model the whole registry every step (core/tools/selector.py).
# Fails open to the full list.
# type: bool · default: 1
# NOVA_TOOL_SELECTOR=1

# Maximum tools the selector puts in front of the model per turn.
# type: int · default: 8
# NOVA_TOOL_CANDIDATES=8

# Load + warm XTTS at startup.
# type: bool · default: 0
# NOVA_TTS_PREWARM=0

# Prewarm utterance.
# type: str · default: Hello there. I am ready to help.
# NOVA_TTS_WARMUP_TEXT=Hello there. I am ready to help.

# Base TTS speed multiplier.
# type: float · default: 1.0
# NOVA_TTS_SPEED=1.0

# Subtle mood-based speech pacing (WS-H).
# type: bool · default: 1
# NOVA_TTS_MOOD_PACING=1

# Max cached TTS clips.
# type: int · default: 64
# NOVA_TTS_CACHE_MAX=64

# Explicit ffmpeg path if not on PATH.
# type: path · default: (empty)
# NOVA_FFMPEG_PATH=

# Transformers STT fallback model.
# type: str · default: openai/whisper-base
# NOVA_STT_MODEL=openai/whisper-base

# faster-whisper model size. Measured: base 73ms mean vs small 106ms on this
# GPU (tests/bench_stt_v3.py).
# type: str · default: base
# NOVA_STT_MODEL_SIZE=base

# Bias the STT decoder toward Marcus's vocabulary (Nova, Qwen, XTTS,
# llama.cpp, Jellyfin...) via initial_prompt. Unbiased, the model produced
# 'Lama.cpp', 'QN' and 'XCTs' on synthetic probes.
# type: bool · default: 1
# NOVA_STT_BIAS=1

# Extra comma-separated terms to add to the STT bias prompt (project names,
# product names, people).
# type: str · default: (empty)
# NOVA_STT_VOCABULARY=

# ─────────────────────────────────────────────────────────────────────────
# Memory
# ─────────────────────────────────────────────────────────────────────────

# Embedding model for semantic memory.
# type: str · default: BAAI/bge-small-en-v1.5
# NOVA_EMBED_MODEL=BAAI/bge-small-en-v1.5

# EXACT model repository commit to embed with. Part of the semantic
# vector-space identity: a repo can change its weights while keeping the same
# model id, and same-id/same-dimension/different-weights would otherwise reuse
# the same Chroma collection and mix two vector spaces. Must be a full commit
# sha — a moving ref (main/latest/head) is refused, because it is not an
# identity. Overriding it to another commit yields its own collection.
# type: str · default: 5c38ec7c405ec4b44b94cc5a9bb96e735b38267a
# NOVA_EMBED_REVISION=5c38ec7c405ec4b44b94cc5a9bb96e735b38267a

# Embedding device (cuda|cpu|auto). Defaults to CPU: bge-small is tiny and
# runs in the background, but on GPU it is a second uncoordinated CUDA
# consumer inside llama.cpp's process, which aborts it with an illegal memory
# access (see core/gpu.py). XTTS no longer shares this process — it has its
# own (services/tts_worker.py) — but the embedding model still does.
# type: str · default: cpu
# NOVA_EMBED_DEVICE=cpu

# Let the model phrase proactive nudges, name learned workflows, and read the
# stress signal, instead of hardcoded templates. Templates remain the fallback
# (U4).
# type: bool · default: 1
# NOVA_LLM_EXPRESSION=1

# Let the model (not regexes) judge task-vs-chat, specialist routing and
# memory query expansion. Deterministic heuristics remain the fallback (U3).
# type: bool · default: 1
# NOVA_LLM_UNDERSTANDING=1

# Semantically index substantive conversation turns.
# type: bool · default: 1
# NOVA_INDEX_TURNS=1

# Record fact provenance (source, evidence, verification status,
# last-confirmed) so assumptions are never stored as settled facts (#19).
# type: bool · default: 1
# NOVA_MEMORY_PROVENANCE=1

# Maintain a semantic world model of general knowledge
# (subject-predicate-object + source) so Nova can answer without re-searching
# the web (#11).
# type: bool · default: 1
# NOVA_WORLD_MODEL=1

# Keep persistent internal thoughts (ideas/questions/improvements) across
# sessions, surfaced only on request (#6).
# type: bool · default: 1
# NOVA_INTERNAL_THOUGHTS=1

# Model Marcus's working patterns (work hours, procrastination likelihood,
# focus window) from recorded signals — predicts, never impersonates (#4).
# type: bool · default: 1
# NOVA_DIGITAL_TWIN=1

# Executive intelligence: proactively synthesize
# goals/reminders/habits/twin/weather into confidence-gated recommendations
# (#1).
# type: bool · default: 1
# NOVA_EXECUTIVE=1

# Enable the persistent agent society: a council of durable specialists the
# Executive routes for multi-perspective questions (#5).
# type: bool · default: 1
# NOVA_AGENT_SOCIETY=1

# Enable safe A/B experimentation: record trials, compare variants, RECOMMEND
# a winner (never auto-applies — adoption is approval-gated) (#15).
# type: bool · default: 1
# NOVA_EXPERIMENTS=1

# Recent turns kept in the reply prompt.
# type: int · default: 20
# NOVA_RECENT_CHAT_TURNS=20

# Summarize the conversation every N turns.
# type: int · default: 8
# NOVA_SUMMARY_EVERY_N=8

# Follow-up dedup window (turns).
# type: int · default: 10
# NOVA_FOLLOWUP_WINDOW=10

# ─────────────────────────────────────────────────────────────────────────
# Behavior / autonomy
# ─────────────────────────────────────────────────────────────────────────

# Enable background autonomy workers.
# type: bool · default: 1
# NOVA_AUTONOMY=1

# Derive internal operational state
# (confidence/uncertainty/workload/focus/energy/curiosity/learning-rate) from
# telemetry and let it advise replies (#12).
# type: bool · default: 1
# NOVA_INTERNAL_STATE=1

# Compute self-benchmark trends/regressions from daily self-eval history and
# flag regressions (#14).
# type: bool · default: 1
# NOVA_SELF_BENCHMARK=1

# Autonomy supervisor tick seconds.
# type: float · default: 5
# NOVA_AUTONOMY_TICK_S=5

# Goal supervisor tick seconds.
# type: float · default: 1
# NOVA_AGENT_TICK_S=1

# Max tool steps per chat turn.
# type: int · default: 6
# NOVA_AGENT_MAX_STEPS=6

# Self-improve cycle interval.
# type: float · default: 1800
# NOVA_SELF_IMPROVE_INTERVAL_S=1800

# Seconds a background worker gets to finish its current step at shutdown
# before it is cancelled. Cancelling mid-write loses the write and leaks
# aiosqlite's non-daemon connection thread (see core/workers/lifecycle.py).
# type: float · default: 3
# NOVA_WORKER_STOP_GRACE_S=3

# How long background GPU work (memory extraction, summarization) waits for a
# live chat turn to finish before proceeding anyway. They share one 1-permit
# GPU semaphore, so without this a reply queues behind them (measured: 3-6s
# turns vs 41s when they collide). The cap stops a long conversation from
# starving memory ingest entirely.
# type: float · default: 45
# NOVA_BACKGROUND_YIELD_MAX_S=45

# Enable the autonomous research worker (periodic web search→summarize→cite
# into the world model). OFF by default: makes network calls (#9).
# type: bool · default: 0
# NOVA_RESEARCH=0

# Autonomous research cycle interval (seconds).
# type: float · default: 3600
# NOVA_RESEARCH_INTERVAL_S=3600

# Resume queued autonomy tasks on boot.
# type: bool · default: 0
# NOVA_RESUME_BACKGROUND_TASKS=0

# Expose the guarded shell.exec tool.
# type: bool · default: 1
# NOVA_ALLOW_SHELL=1

# Expose network plugins to the agent.
# type: bool · default: 1
# NOVA_ALLOW_NETWORK_TOOLS=1

# Token budget for storytelling mode.
# type: int · default: 1200
# NOVA_STORY_TOKENS=1200

# Extra segments a long story may take after hitting the token budget
# (finish_reason=length). Bounded so a model that never stops cannot loop.
# type: int · default: 3
# NOVA_STORY_MAX_CONTINUATIONS=3

# ─────────────────────────────────────────────────────────────────────────
# Scheduling
# ─────────────────────────────────────────────────────────────────────────

# Reminder worker poll interval.
# type: float · default: 30
# NOVA_REMINDER_POLL_S=30

# Morning briefing time (empty disables).
# type: hhmm · default: 08:00
# NOVA_BRIEFING_TIME=08:00

# ─────────────────────────────────────────────────────────────────────────
# Developer mode / security
# ─────────────────────────────────────────────────────────────────────────

# Enable guarded self-editing.
# type: bool · default: 0
# NOVA_DEV_MODE=0

# Actuator permission policy: locked (read-only) | guarded (default;
# standard/admin need confirmation, critical denied) | trusted (auto-allow
# through standard).
# type: str · default: guarded
# NOVA_PERMISSION_MODE=guarded

# Allow computer-control actions to actually EXECUTE (still gated per-action +
# needs a platform adapter). OFF by default — actions are otherwise dry-run
# only (Phase 8).
# type: bool · default: 0
# NOVA_COMPUTER_CONTROL=0

# Bearer token required on all endpoints when set.
# (secret — keep this only in .env, never in .env.example)
NOVA_API_TOKEN=

# Extra token for maintenance endpoints.
# (secret — keep this only in .env, never in .env.example)
NOVA_ADMIN_TOKEN=

# CORS origins override (comma-separated).
# type: csv · default: (empty)
# NOVA_ALLOWED_ORIGINS=

# ─────────────────────────────────────────────────────────────────────────
# Project builder
# ─────────────────────────────────────────────────────────────────────────

# Token budget per generated project file.
# type: int · default: 3000
# NOVA_PROJECT_FILE_TOKENS=3000

# Run generated projects as a build check.
# type: bool · default: 1
# NOVA_PROJECT_RUN_CHECK=1

# Generate + run logic tests for projects.
# type: bool · default: 1
# NOVA_PROJECT_LOGIC_TESTS=1

# ─────────────────────────────────────────────────────────────────────────
# Image/video generation service
# ─────────────────────────────────────────────────────────────────────────

# Local imagegen service port.
# type: int · default: 8801
# NOVA_IMAGEGEN_PORT=8801

# Diffusion model id.
# type: str · default: stabilityai/sdxl-turbo
# NOVA_IMAGEGEN_MODEL=stabilityai/sdxl-turbo

# Physical GPU pinned via CUDA_VISIBLE_DEVICES.
# type: str · default: 1
# NOVA_IMAGEGEN_CUDA_DEVICE=1

# ─────────────────────────────────────────────────────────────────────────
# Avatar (photo-relief pipeline)
# ─────────────────────────────────────────────────────────────────────────

# Avatar hologram emission strength.
# type: float · default: 0.4
# NOVA_PORTRAIT_EMISSION=0.4

# Avatar color grade.
# type: float · default: 1.0
# NOVA_PORTRAIT_GRADE=1.0

# Avatar eye vertical anchor.
# type: float · default: 0.565
# NOVA_PORTRAIT_EYE_V=0.565

# Avatar eye span.
# type: float · default: 0.205
# NOVA_PORTRAIT_EYE_SPAN=0.205

# Avatar mouth vertical anchor.
# type: float · default: 0.395
# NOVA_PORTRAIT_MOUTH_V=0.395
